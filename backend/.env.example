# CogniLearn AI — Backend Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Application ---
APP_NAME=CogniLearn AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
CORS_ORIGINS_RAW=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql+psycopg2://cognilearn:cognilearn@db:5432/cognilearn_ai
DATABASE_ECHO=false

# --- Security ---
SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- AI Service Layer ---
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-1.5-pro
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=3

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
