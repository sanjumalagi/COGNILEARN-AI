# CogniLearn AI — Frontend Environment Configuration
# Copy this file to `.env` and adjust as needed. Never commit `.env`.

# Base URL for the backend REST API. Left unset in local development so
# Vite's dev-server proxy (see vite.config.ts) forwards /api requests to
# the backend on localhost:8000.
# VITE_API_BASE_URL=http://localhost:8000/api/v1
